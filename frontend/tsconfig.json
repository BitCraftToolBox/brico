{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "noEmit": true,
    // Node's built-in test runner resolves ESM relative imports literally, so *.test.ts must
    // import "./filter.ts" with its extension. Safe with noEmit: nothing is rewritten on output.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["vinxi/types/client"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
