# brico-bot configuration. Copy to `.env` (gitignored) and edit; real environment variables win
# over anything set here.

# ── prism's relay-module (the BitCraft read-mirror) ──────────────────────────
#BRICO_RELAY_HOST=http://127.0.0.1:3000
#BRICO_RELAY_MODULE=prism-relay

# ── brico-app (brico's own module) ───────────────────────────────────────────
#BRICO_APP_ENABLED=1
#BRICO_APP_HOST=http://127.0.0.1:3000
#BRICO_APP_MODULE=brico-app

# ── bridge behaviour ────────────────────────────────────────────────────────
#BRICO_BOT_SNAPSHOT_INTERVAL_MS=1000
#BRICO_BOT_RECONCILE_INTERVAL_MS=300000
#BRICO_BOT_RECONNECT_DELAY_MS=5000
#BRICO_BOT_RECONNECT_MAX_DELAY_MS=60000
#BRICO_BOT_HEARTBEAT_MS=60000
#BRICO_BOT_LOG_LEVEL=info

# ── paths (relative paths resolve against backend/brico-bot/) ───────────────
#BRICO_BOT_STATE_DIR=.state

# CDN that item/frame icon paths resolve against (Discord watch display thumbnails).
#BRICO_ASSET_CDN_BASE=https://cdn.brico.app

# ── BitAuth/Discord link callback HTTP server ────────────────────────────────
# Bind address and public base URL of the HTTP server (/auth/*, /icons/*, /discord/*, /metrics).
# Code defaults are container-friendly (0.0.0.0:8080, https://bot.brico.app); override all three
# when running bare on a workstation.
#BRICO_BOT_HTTP_HOST=127.0.0.1
#BRICO_BOT_HTTP_PORT=8787
#BRICO_BOT_HTTP_BASE_URL=http://127.0.0.1:8787
# Where the browser lands after a link attempt (?linked=<provider> or ?linkError=<message> appended).
#BRICO_BOT_LINK_RETURN_URL=http://localhost:3001/account/profile
# Comma-separated extra origins a login request's &returnUrl may redirect back to; the origin of
# BRICO_BOT_LINK_RETURN_URL is always allowed, anything else falls back to it.
#BRICO_BOT_LINK_RETURN_URL_ALLOWED_ORIGINS=

# ── BitAuth (BitCraft account linking) ───────────────────────────────────────
# Both unset (the default) disables BitAuth linking entirely — /auth/bitauth/* returns 503 rather
# than the process failing to start. Register brico-bot's callback URL
# (BITAUTH_REDIRECT_URI, or BRICO_BOT_HTTP_BASE_URL + /auth/bitauth/callback) with BitAuth first.
#BITAUTH_ISSUER=https://auth.trinit.is
#BITAUTH_CLIENT_ID=
#BITAUTH_CLIENT_SECRET=
#BITAUTH_REDIRECT_URI=
#BITAUTH_SCOPE=openid profile

# ── Discord OAuth (account linking for a non-Discord brico login) ───────────
# Both unset (the default) disables this route — the SpacetimeAuth-login shortcut and the
# bot-initiated /link flow are unaffected. Register the callback URL as a Discord OAuth2 redirect.
#DISCORD_OAUTH_CLIENT_ID=
#DISCORD_OAUTH_CLIENT_SECRET=
#DISCORD_OAUTH_REDIRECT_URI=

# ── Discord bot (slash commands) ─────────────────────────────────────────────
# All three unset disables the bot (/discord/interactions returns 503). Interactions arrive as signed
# HTTP POSTs (no gateway); set the Developer Portal Interactions Endpoint URL to
# BRICO_BOT_HTTP_BASE_URL + /discord/interactions. PUBLIC_KEY is the application's Ed25519 key.
#DISCORD_BOT_TOKEN=
#DISCORD_PUBLIC_KEY=
#DISCORD_APPLICATION_ID=
# OAuth2 client secret; only needed for the self-serve /discord/install flow (unset: that route 503s).
#DISCORD_BOT_CLIENT_SECRET=
# Guild that `npm run discord:register-commands` registers to; not read by the bot process.
#DISCORD_TEST_GUILD_ID=
