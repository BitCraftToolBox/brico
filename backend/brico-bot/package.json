{
  "name": "@brico/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Persistent bridge worker: holds live SpacetimeDB connections to prism's relay-module and brico-app, runs the shared filter engine across both.",
  "main": "src/main.ts",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brico/bindings": "*",
    "@brico/bitcraft-bindings": "*",
    "@brico/crafts": "*",
    "jose": "^6.2.0",
    "prom-client": "^15.1.3",
    "spacetimedb": "^2.9.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
