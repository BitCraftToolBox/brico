{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // The tests run under `node --test` (native type stripping), whose ESM resolver takes
    // relative specifiers literally, so *.test.ts must import "./filter.ts" with its extension.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
